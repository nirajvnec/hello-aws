<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HelloAws</RootNamespace>
  </PropertyGroup>

  <!-- Container debugging: the Docker extension mounts this project folder at /app,
       so record /app paths in the Debug PDB so breakpoints match inside the container. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <PathMap>$(MSBuildProjectDirectory)=/app</PathMap>
  </PropertyGroup>

</Project>
